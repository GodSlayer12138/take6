# Rebuildable dependencies and bundles
node_modules/
dist/

# Local Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Temporary editor/OS files
*.tmp
.DS_Store
Thumbs.db

# Local credentials and process logs
.env
.env.*
!.env.example
*.log

# Local training data and numbered intermediate checkpoints.
# Keep inference weights, frozen sources, manifests and evaluation traces.
/artifacts/training/
/artifacts/**/dataset.pt
/artifacts/**/*.npy
/artifacts/**/*.npz
/artifacts/models/*-u[0-9]*.pt
/artifacts/models/*-e[0-9]*.pt

# Download the pinned upstream take6 files with tools/fetch_take6.py.
# Publish provenance and evaluation results, not a re-hosted weight bundle.
/external/take6/*
!/external/take6/provenance.json

# Local deployment metadata
.vercel/
